#!/usr/bin/env python3
"""Thin shim for non-pip installs (git clone + ./install.sh).
Delegates to the crossweave package under ../src.
"""
import os
import sys

SHIM_PATH = os.path.realpath(__file__)
REPO_DIR = os.path.dirname(os.path.dirname(SHIM_PATH))


def _use_project_venv_for_tray():
    if sys.argv[1:2] != ["tray"]:
        return

    if os.name == "nt":
        python = os.path.join(REPO_DIR, ".venv", "Scripts", "python.exe")
    else:
        python = os.path.join(REPO_DIR, ".venv", "bin", "python")

    venv_dir = os.path.join(REPO_DIR, ".venv")
    if os.path.isfile(python) and os.path.abspath(sys.prefix) != os.path.abspath(venv_dir):
        os.execv(python, [python, SHIM_PATH, *sys.argv[1:]])


_use_project_venv_for_tray()
sys.path.insert(0, os.path.join(REPO_DIR, "src"))

from crossweave.cli import main  # noqa: E402

if __name__ == "__main__":
    main()
